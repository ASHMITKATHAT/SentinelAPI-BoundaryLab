{
  "openapi": "3.1.0",
  "info": {
    "title": "BoundaryLab control API — specification only",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080/api/v1",
      "description": "Intended local development server; not currently implemented"
    }
  ],
  "security": [
    {
      "OperatorSession": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "operationId": "createSession",
        "summary": "Local bootstrap login; Origin checked; request body not logged",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          }
        },
        "security": []
      },
      "delete": {
        "operationId": "deleteSession",
        "summary": "Invalidate session",
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/targets": {
      "get": {
        "operationId": "listTargets",
        "summary": "Trusted configured targets",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Target"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/specs": {
      "post": {
        "operationId": "importSpec",
        "summary": "Import OpenAPI 3.1 JSON; 1 MiB cap; no external refs",
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spec"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecImport"
              }
            }
          }
        }
      }
    },
    "/policies": {
      "post": {
        "operationId": "createPolicy",
        "summary": "Create immutable validated policy version",
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyCreate"
              }
            }
          }
        }
      }
    },
    "/policies/{policy_id}/approval": {
      "post": {
        "operationId": "approvePolicy",
        "summary": "Approve exact policy hash",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Approval"
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "Queue approved scope and policy",
        "responses": {
          "202": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRuns",
        "summary": "Recent runs",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Run state and scoped assessment",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "operationId": "getEvents",
        "summary": "Ordered events after cursor",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "events",
                    "next_cursor"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          }
        ]
      }
    },
    "/runs/{run_id}/results": {
      "get": {
        "operationId": "getResults",
        "summary": "Cases, findings and sanitized evidence",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Results"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "summary": "Idempotent cancellation request",
        "responses": {
          "202": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/comparisons": {
      "post": {
        "operationId": "compareRuns",
        "summary": "Compare 2–3 compatible completed runs; 409 on fingerprint mismatch",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comparison"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComparisonRequest"
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/artifacts": {
      "post": {
        "operationId": "createArtifact",
        "summary": "Generate sanitized report with replay manifest",
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Artifact"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtifactRequest"
              }
            }
          }
        }
      }
    },
    "/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getArtifact",
        "summary": "Download authorized generated artifact",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Typed error; see documentation for 401/403/409/413/422/429/503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OperatorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "boundarylab_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "IdentityReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation": {
            "enum": [
              "owner",
              "collaborator",
              "foreign_tenant"
            ]
          },
          "tenant": {
            "enum": [
              "A",
              "B"
            ]
          },
          "credential_ref": {
            "type": "string",
            "pattern": "^lab/[a-z]+$"
          }
        },
        "required": [
          "relation",
          "tenant",
          "credential_ref"
        ]
      },
      "PolicyDocument": {
        "title": "BoundaryLab supported invoice policy v1",
        "description": "Specification artifact. This intentionally supports one reviewed scenario, not an arbitrary executable DSL.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "scenario": {
            "const": "invoice-sharing-v1"
          },
          "fixture_semantics_version": {
            "const": "invoice-fixtures-v1"
          },
          "identities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "alice": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relation": {
                    "enum": [
                      "owner",
                      "collaborator",
                      "foreign_tenant"
                    ]
                  },
                  "tenant": {
                    "enum": [
                      "A",
                      "B"
                    ]
                  },
                  "credential_ref": {
                    "type": "string",
                    "pattern": "^lab/[a-z]+$"
                  }
                },
                "required": [
                  "relation",
                  "tenant",
                  "credential_ref"
                ]
              },
              "bob": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relation": {
                    "enum": [
                      "owner",
                      "collaborator",
                      "foreign_tenant"
                    ]
                  },
                  "tenant": {
                    "enum": [
                      "A",
                      "B"
                    ]
                  },
                  "credential_ref": {
                    "type": "string",
                    "pattern": "^lab/[a-z]+$"
                  }
                },
                "required": [
                  "relation",
                  "tenant",
                  "credential_ref"
                ]
              },
              "mallory": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relation": {
                    "enum": [
                      "owner",
                      "collaborator",
                      "foreign_tenant"
                    ]
                  },
                  "tenant": {
                    "enum": [
                      "A",
                      "B"
                    ]
                  },
                  "credential_ref": {
                    "type": "string",
                    "pattern": "^lab/[a-z]+$"
                  }
                },
                "required": [
                  "relation",
                  "tenant",
                  "credential_ref"
                ]
              }
            },
            "required": [
              "alice",
              "bob",
              "mallory"
            ]
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "private_invoice": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "owner": {
                    "const": "alice"
                  },
                  "initially_shared_with": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "bob"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "owner",
                  "initially_shared_with"
                ]
              },
              "shared_invoice": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "owner": {
                    "const": "alice"
                  },
                  "initially_shared_with": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "bob"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "owner",
                  "initially_shared_with"
                ]
              }
            },
            "required": [
              "private_invoice",
              "shared_invoice"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "operation_id": {
                  "enum": [
                    "getInvoicePreview",
                    "getInvoice",
                    "queueExport",
                    "getExportContent"
                  ]
                },
                "resource": {
                  "enum": [
                    "private_invoice",
                    "shared_invoice"
                  ]
                },
                "allowed_relations": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "owner",
                      "active_collaborator"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "operation_id",
                "resource",
                "allowed_relations"
              ]
            },
            "minItems": 4,
            "maxItems": 4
          },
          "restricted_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation_id": {
                  "const": "getInvoice"
                },
                "pointer": {
                  "const": "/internal_bank_ref"
                },
                "allowed_relations": {
                  "const": [
                    "owner"
                  ]
                }
              },
              "required": [
                "operation_id",
                "pointer",
                "allowed_relations"
              ]
            },
            "minItems": 1,
            "maxItems": 1
          },
          "revocation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation_id": {
                "const": "revokeShare"
              },
              "probe_operation_id": {
                "const": "getExportContent"
              },
              "grace_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "probe_margin_ms": {
                "type": "integer",
                "minimum": 200,
                "maximum": 1000
              },
              "timing_anchor": {
                "const": "successful_revoke_ack_monotonic"
              },
              "applies_to": {
                "const": "fresh_bearer_requests"
              },
              "deny_statuses": {
                "const": [
                  403,
                  404
                ]
              }
            },
            "required": [
              "operation_id",
              "probe_operation_id",
              "grace_ms",
              "probe_margin_ms",
              "timing_anchor",
              "applies_to",
              "deny_statuses"
            ]
          },
          "marker_pointer": {
            "const": "/content_marker"
          },
          "required_cases": {
            "const": [
              "C01",
              "C02",
              "C03",
              "C04",
              "C05",
