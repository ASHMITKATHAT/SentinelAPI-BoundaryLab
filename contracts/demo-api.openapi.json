  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1
          },
          "content_marker": {
            "type": "string",
            "minLength": 1
          },
          "internal_bank_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "owner_id",
          "tenant_id",
          "content_marker"
        ]
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "invoice_id": {
            "type": "string",
            "minLength": 1
          },
          "creator_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "queued",
              "ready"
            ]
          }
        },
        "required": [
          "id",
          "invoice_id",
          "creator_id",
          "state"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
